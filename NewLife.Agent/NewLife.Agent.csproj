<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  
  <PropertyGroup>
    <TargetFrameworks>net40;net45;net461;netstandard2.0;netstandard2.1;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>NewLife.Agent</AssemblyName>
    <RootNamespace>NewLife.Agent</RootNamespace>
    <AssemblyTitle>Cross-platform Service Agent</AssemblyTitle>
    <Description>Cross-platform system service and daemon management framework with install, monitoring, and auto-restart support.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>10.18</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin</OutputPath>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <!-- CS8600 为 NewLife.Core 源生成器控制器分发产物（net6.0+ 目标）引入，非本仓库代码告警；2026-10-16 用 Core 12.0.2026.1016-beta0317 复测仍复现，待上游修复后随升级移除 -->
    <!-- NU1903：net40 目标经 NewLife.Core 传递 System.Net.Http 2.0.20710（GHSA-7jgj-8wvc-jh57），
         该包没有 net40 可用的修复版本；NuGet 审计按项目而非 TFM 报告，无法只压制 net40，
         因此统一压制。其余目标的依赖图已用 dotnet list package 漏洞扫描验证无问题；
         将来移除 net40 目标时应同步删除 NU1903。 -->
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035;NU1903;CS8600</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>CA2007</WarningsAsErrors>
  </PropertyGroup>

  <!-- net8.0+ 常驻启用 AOT/裁剪分析器：0 告警成为构建期硬约束。注意 SDK 会将 IsTrimmable 一并置真，这些目标的程序集会嵌入 IsTrimmable 元数据 -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://newlifex.com/core/agent</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.Agent</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;X组件;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>新增 31 种语言本地化，内建命令/配置描述/Hosting 消息/Web 面板全面多语言化并支持 RTL；Web 面板新增 WebBind 绑定配置与语言切换；NativeAOT 全面适配并覆盖 12 个 RID 发布冒烟；新增多架构单元测试矩阵与 riscv64/s390x 指令集冒烟；修复 SysVinit 路径查询与 UseAgentService 无参调用问题；升级 NewLife.Core 至 12.0.2026.1024</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="BackgroundService.cs" />
    <Compile Remove="IHostedService.cs" />
  </ItemGroup>
  <!-- net40 不编译 Web 面板，wwwroot 资源无需嵌入该目标 -->
  <ItemGroup Condition="'$(TargetFramework)'!='net40'">
    <EmbeddedResource Include="WebPanel\wwwroot\index.html" />
    <EmbeddedResource Include="WebPanel\wwwroot\favicon.ico" />
    <EmbeddedResource Include="WebPanel\wwwroot\i18n\*.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <!-- 本地联调：加 -p:UseLocalNewLifeSource=true 改为项目引用 NewLife.Core 源码，便于 AOT 适配期间同步修改上游 -->
  <PropertyGroup>
    <NewLifeSourceRoot Condition="'$(NewLifeSourceRoot)' == ''">$(MSBuildProjectDirectory)\..\..</NewLifeSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)'!='net40' and '$(UseLocalNewLifeSource)' == 'true'">
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core\NewLife.Core.csproj" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained" />
    <!-- 项目引用不会像 NuGet 包那样把 analyzers 传递下来，本地联调需显式挂上 Core 源生成器 -->
    <ProjectReference Include="$(NewLifeSourceRoot)\NewLife.Core\NewLife.Core.SourceGenerator\NewLife.Core.SourceGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetTargetFramework="TargetFramework=netstandard2.0" Private="false" AdditionalProperties="PublishAot=false" GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier;RuntimeIdentifiers" />
    <!-- 项目引用模式缺少 Core 包的 props，显式声明源生成器可见属性 -->
    <CompilerVisibleProperty Include="NewLifeLocalizationGenerateL" />
    <CompilerVisibleProperty Include="NewLifeLocalizationOverwrite" />
    <CompilerVisibleProperty Include="NewLifeLocalizationLanguages" />
    <!-- Core 包的 props 会把 Locales\*.yml 挂成 AdditionalFiles，项目引用模式需自行挂载 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/Locales/*.yml" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'!='net40' and '$(UseLocalNewLifeSource)' != 'true'">
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1115-beta2355" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net40'">
    <!-- net40 无 NewLife.Core 12，沿用最后的 net40 专用版本 -->
    <PackageReference Include="NewLife.Core" Version="10.10.2024.0801-net40" />
  </ItemGroup>
</Project>